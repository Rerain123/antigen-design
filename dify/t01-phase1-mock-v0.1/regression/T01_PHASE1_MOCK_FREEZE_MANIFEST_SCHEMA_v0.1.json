{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "T01_PHASE1_MOCK_FREEZE_MANIFEST_SCHEMA_v0.1.json",
  "title": "T01-PHASE1-MOCK-FREEZE-MANIFEST-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_type",
    "manifest_version",
    "release_id",
    "release_state",
    "frozen_at",
    "campaign_id",
    "binding_profile",
    "m4_result",
    "regression_partitions",
    "frozen_asset_count",
    "frozen_assets",
    "acceptance",
    "scope_guards",
    "next_release_gate"
  ],
  "properties": {
    "$schema": {"const": "T01_PHASE1_MOCK_FREEZE_MANIFEST_SCHEMA_v0.1.json"},
    "document_type": {"const": "T01_PHASE1_MOCK_FREEZE_MANIFEST"},
    "manifest_version": {"const": "T01-PHASE1-MOCK-FREEZE-MANIFEST-v0.1"},
    "release_id": {"const": "T01-PHASE1-MOCK-v0.1"},
    "release_state": {"const": "FROZEN"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "campaign_id": {"type": "string", "pattern": "^t01p1m-v01-reg-[0-9]{8}-[a-z][a-z0-9-]{0,31}$"},
    "binding_profile": {"const": "local_dify_1_17"},
    "m4_result": {"$ref": "#/$defs/hashRecord"},
    "regression_partitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "documentation_markdown_count", "current_phase1_test_count", "legacy_full_mock_test_count", "legacy_s07_test_count"],
      "properties": {
        "path": {"$ref": "#/$defs/projectPath"},
        "status": {"const": "PASS"},
        "documentation_markdown_count": {"type": "integer", "minimum": 113},
        "current_phase1_test_count": {"type": "integer", "minimum": 164},
        "legacy_full_mock_test_count": {"const": 74},
        "legacy_s07_test_count": {"const": 41}
      }
    },
    "frozen_asset_count": {"type": "integer", "minimum": 1},
    "frozen_assets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hashRecord"}},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count_per_role", "submission_count_per_role", "request_variant_count_per_role", "finalization_count_per_role", "dify_run_count_per_role", "checkpoint_plan_count_per_role", "checkpoint_count_per_role", "global_assertion_count", "focus_assertion_count_per_role", "coverage_gate_count", "parity_case_count", "blocker_failure_count"],
      "properties": {
        "case_count_per_role": {"const": 21},
        "submission_count_per_role": {"const": 23},
        "request_variant_count_per_role": {"const": 22},
        "finalization_count_per_role": {"const": 4},
        "dify_run_count_per_role": {"const": 27},
        "checkpoint_plan_count_per_role": {"const": 4},
        "checkpoint_count_per_role": {"const": 16},
        "global_assertion_count": {"const": 12},
        "focus_assertion_count_per_role": {"const": 44},
        "coverage_gate_count": {"const": 10},
        "parity_case_count": {"const": 21},
        "blocker_failure_count": {"const": 0}
      }
    },
    "scope_guards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_classification", "scientific_compute", "scientific_execution_count", "scientific_network_request_count", "legacy_implementation_reuse_count", "himat_backend_access_count", "secret_finding_count", "production_state"],
      "properties": {
        "data_classification": {"const": "MOCK_DATA"},
        "scientific_compute": {"const": false},
        "scientific_execution_count": {"const": 0},
        "scientific_network_request_count": {"const": 0},
        "legacy_implementation_reuse_count": {"const": 0},
        "himat_backend_access_count": {"const": 0},
        "secret_finding_count": {"const": 0},
        "production_state": {"const": "NOT_DEPLOYED"}
      }
    },
    "next_release_gate": {"const": "PH1-REAL-W1_READY"}
  },
  "$defs": {
    "hashRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/projectPath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    }
  }
}
