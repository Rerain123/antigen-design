{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "T01_PHASE1_MOCK_M3_ACCEPTANCE_RESULT_SCHEMA_v0.1.json",
  "title": "T01-PHASE1-MOCK-M3-ACCEPTANCE-RESULT-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_type",
    "result_version",
    "binding_profile",
    "status",
    "implementation_state",
    "instance_mappings",
    "workflow_facts",
    "main",
    "debug",
    "parity",
    "scientific_execution_count",
    "scientific_network_request_count",
    "legacy_implementation_reuse_count",
    "himat_backend_access_count",
    "blocker_failure_count"
  ],
  "properties": {
    "$schema": {"const": "T01_PHASE1_MOCK_M3_ACCEPTANCE_RESULT_SCHEMA_v0.1.json"},
    "document_type": {"const": "T01_PHASE1_MOCK_M3_ACCEPTANCE_RESULT"},
    "result_version": {"const": "T01-PHASE1-MOCK-M3-ACCEPTANCE-RESULT-v0.1"},
    "binding_profile": {"const": "local_dify_1_17"},
    "status": {"enum": ["PASS", "FAIL"]},
    "implementation_state": {"const": "M3_DIFY_EXECUTED"},
    "instance_mappings": {"$ref": "#/$defs/instanceMappings"},
    "workflow_facts": {"$ref": "#/$defs/workflowFacts"},
    "main": {"$ref": "#/$defs/stage"},
    "debug": {"$ref": "#/$defs/stage"},
    "parity": {"$ref": "#/$defs/parity"},
    "scientific_execution_count": {"const": 0},
    "scientific_network_request_count": {"const": 0},
    "legacy_implementation_reuse_count": {"const": 0},
    "himat_backend_access_count": {"const": 0},
    "blocker_failure_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["PASS", "FAIL"]},
    "instanceMappings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "workflows"],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stable_provider_id", "instance_record_id"],
          "properties": {
            "stable_provider_id": {"const": "t01-phase1-mock-mcp-v01"},
            "instance_record_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"}
          }
        },
        "workflows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stable_workflow_id", "app_id", "draft_workflow_id"],
            "properties": {
              "stable_workflow_id": {
                "enum": [
                  "t01_phase1_mock_v01.workflow.main",
                  "t01_phase1_mock_v01.workflow.debug"
                ]
              },
              "app_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
              "draft_workflow_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"}
            }
          }
        }
      }
    },
    "workflowFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registered_workflow_ids", "provider_id", "tool_ids"],
      "properties": {
        "registered_workflow_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "t01_phase1_mock_v01.workflow.main",
              "t01_phase1_mock_v01.workflow.debug"
            ]
          }
        },
        "provider_id": {"const": "t01-phase1-mock-mcp-v01"},
        "tool_ids": {
          "type": "array",
          "minItems": 26,
          "maxItems": 26,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^t01_phase1_mock_v01\\.tool\\."}
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "status", "detail"],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "detail": {"type": ["string", "null"]}
      }
    },
    "coverageGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "required_scenario_keys"],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "required_scenario_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "scenario_key",
        "submission_actions",
        "final_run_id",
        "recovery_of_run_id",
        "run_status",
        "canonical_envelope_sha256",
        "status"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 21},
        "scenario_key": {"type": "string", "minLength": 1},
        "submission_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "enum": ["CREATE_RUN", "RETURN_EXISTING_RUN", "REJECT_REQUEST"]
          }
        },
        "final_run_id": {
          "type": "string",
          "pattern": "^t01-phase1-mock-v01-run-[0-9a-f-]{36}$"
        },
        "recovery_of_run_id": {
          "type": ["string", "null"],
          "pattern": "^t01-phase1-mock-v01-run-[0-9a-f-]{36}$"
        },
        "run_status": {
          "enum": ["COMPLETED", "COMPLETED_WITH_GAPS", "FAILED", "TIMED_OUT", "CANCELLED"]
        },
        "canonical_envelope_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "status",
        "case_count",
        "submission_count",
        "checkpoint_plan_count",
        "checkpoint_count",
        "global_assertion_count",
        "focus_assertion_count",
        "coverage_gate_count",
        "blocker_failure_count",
        "capture_sha256",
        "instance_run_mappings",
        "global_assertions",
        "focus_assertions",
        "coverage_gates",
        "case_results"
      ],
      "properties": {
        "stage": {"enum": ["M3_DIFY_MAIN", "M3_DIFY_DEBUG"]},
        "status": {"$ref": "#/$defs/status"},
        "case_count": {"const": 21},
        "submission_count": {"const": 23},
        "checkpoint_plan_count": {"const": 4},
        "checkpoint_count": {"const": 16},
        "global_assertion_count": {"const": 9},
        "focus_assertion_count": {"const": 44},
        "coverage_gate_count": {"const": 10},
        "blocker_failure_count": {"type": "integer", "minimum": 0},
        "capture_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["submissions_path", "finalizations_path", "driver_path"],
          "properties": {
            "submissions_path": {"$ref": "#/$defs/sha256"},
            "finalizations_path": {"$ref": "#/$defs/sha256"},
            "driver_path": {"$ref": "#/$defs/sha256"}
          }
        },
        "instance_run_mappings": {
          "type": "array",
          "minItems": 27,
          "maxItems": 27,
          "items": {"$ref": "#/$defs/instanceRunMapping"}
        },
        "global_assertions": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "focus_assertions": {
          "type": "array",
          "minItems": 44,
          "maxItems": 44,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "coverage_gates": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/coverageGate"}
        },
        "case_results": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": {"$ref": "#/$defs/case"}
        }
      }
    },
    "instanceRunMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_kind",
        "ordinal",
        "scenario_key",
        "submission_key",
        "operation",
        "dify_workflow_run_id",
        "canonical_request_id",
        "canonical_run_id",
        "submission_action",
        "dify_status"
      ],
      "properties": {
        "capture_kind": {"enum": ["SUBMISSION", "FINALIZATION"]},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 23},
        "scenario_key": {"type": "string", "minLength": 1},
        "submission_key": {"type": "string", "minLength": 1},
        "operation": {"enum": ["SUBMIT", "FINALIZE_EXISTING"]},
        "dify_workflow_run_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
        "canonical_request_id": {
          "type": "string",
          "pattern": "^t01-phase1-mock-v01-req-[0-9a-f-]{36}$"
        },
        "canonical_run_id": {
          "type": ["string", "null"],
          "pattern": "^t01-phase1-mock-v01-run-[0-9a-f-]{36}$"
        },
        "submission_action": {
          "type": ["string", "null"],
          "enum": ["CREATE_RUN", "RETURN_EXISTING_RUN", "REJECT_REQUEST", "FINALIZE_EXISTING", null]
        },
        "dify_status": {"const": "succeeded"}
      }
    },
    "parityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_key",
        "status",
        "first_difference",
        "main_sha256",
        "debug_sha256"
      ],
      "properties": {
        "scenario_key": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "first_difference": {"type": ["string", "null"]},
        "main_sha256": {"$ref": "#/$defs/sha256"},
        "debug_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "status",
        "case_count",
        "global_016_status",
        "failure_count",
        "results"
      ],
      "properties": {
        "stage": {"const": "M3_MAIN_DEBUG_PARITY"},
        "status": {"$ref": "#/$defs/status"},
        "case_count": {"const": 21},
        "global_016_status": {"$ref": "#/$defs/status"},
        "failure_count": {"type": "integer", "minimum": 0},
        "results": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": {"$ref": "#/$defs/parityResult"}
        }
      }
    }
  }
}
