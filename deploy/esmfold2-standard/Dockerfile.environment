FROM public.ecr.aws/docker/library/python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements.resolved.txt /build/requirements.resolved.txt
RUN pip install --no-cache-dir --no-compile -r /build/requirements.resolved.txt
COPY TRANSFORMERS_SOURCE /build/transformers
RUN pip install --no-cache-dir --no-compile /build/transformers
COPY ESM_SOURCE /build/esm
RUN pip install --no-cache-dir --no-compile --no-deps /build/esm \
 && pip freeze > /opt/requirements.resolved.txt \
 && rm -rf /build
RUN apt-get update \
 && apt-get install --no-install-recommends -y gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2 TRITON_CACHE_DIR=/tmp/triton \
    XDG_CACHE_HOME=/tmp/cache MPLCONFIGDIR=/tmp/matplotlib
RUN groupadd --gid 10001 t01 && useradd --uid 10001 --gid 10001 --no-create-home t01
USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["python", "-B"]
