{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "tool_id": {
      "enum": [
        "t01.real.engineering_probe",
        "t01.real.ingest_structure",
        "t01.real.map_structure",
        "t01.real.deeptmhmm",
        "t01.real.assess_structure_quality",
        "t01.real.freesasa",
        "t01.real.af3",
        "t01.real.esmfold2"
      ]
    },
    "node_id": {
      "anyOf": [
        {
          "enum": [
            "N01",
            "N02"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "run_mode": {
      "enum": [
        "engineering_example",
        "g0_probe",
        "pipeline"
      ]
    },
    "request_artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "request",
            "input",
            "result",
            "raw",
            "diagnostic",
            "log",
            "environment"
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_kind": {
          "enum": [
            "ENGINEERING_FIXTURE",
            "G0_REAL_OUTPUT",
            "PIPELINE_REAL_OUTPUT",
            "LOCAL_INPUT"
          ]
        }
      },
      "required": [
        "artifact_id",
        "run_id",
        "job_id",
        "attempt_id",
        "role",
        "media_type",
        "sha256",
        "size_bytes",
        "evidence_kind"
      ],
      "additionalProperties": false
    },
    "execution_profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "rule_profile": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "request_id",
    "idempotency_key",
    "tool_id",
    "node_id",
    "run_mode",
    "request_artifact",
    "execution_profile",
    "rule_profile"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:t01:phase1:real:0.1.0:submit"
}
