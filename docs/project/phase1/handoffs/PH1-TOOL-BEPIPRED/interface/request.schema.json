{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "tool_id": {
      "enum": [
        "t01.real.freesasa",
        "t01.real.bepipred"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_mode": {
      "enum": [
        "engineering_example",
        "g0_probe",
        "pipeline"
      ]
    },
    "node_id": {
      "enum": [
        "N02",
        "N13",
        "N04"
      ]
    },
    "inputs": {
      "type": "object"
    },
    "parameters": {
      "type": "object"
    },
    "rule_profile": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "tool_id",
    "request_id",
    "run_mode",
    "node_id",
    "inputs",
    "parameters",
    "rule_profile"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tool_id": {
            "const": "t01.real.freesasa"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "string",
                "pattern": "^[A-Z]+$"
              },
              "structure": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\])[A-Za-z0-9_\\u0080-\\uffff][^\\x00-\\x1f]*$"
                      },
                      "sha256": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mapping": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\])[A-Za-z0-9_\\u0080-\\uffff][^\\x00-\\x1f]*$"
                      },
                      "sha256": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mapping_status": {
                "enum": [
                  "unverified",
                  "verified",
                  "unreliable"
                ]
              },
              "quality_confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            },
            "required": [
              "sequence",
              "structure",
              "mapping",
              "mapping_status",
              "quality_confidence"
            ],
            "additionalProperties": false
          },
          "parameters": {
            "type": "object",
            "properties": {
              "config": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\])[A-Za-z0-9_\\u0080-\\uffff][^\\x00-\\x1f]*$"
                      },
                      "sha256": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "config"
            ],
            "additionalProperties": false
          },
          "node_id": {
            "enum": [
              "N02",
              "N13"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool_id": {
            "const": "t01.real.bepipred"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "string",
                "pattern": "^[A-Z]+$"
              }
            },
            "required": [
              "sequence"
            ],
            "additionalProperties": false
          },
          "parameters": {
            "type": "object",
            "properties": {
              "threshold": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 0.2
              },
              "top_percent": {
                "const": 20
              },
              "min_peak_length": {
                "const": 6
              },
              "gap_tolerance": {
                "const": 2
              },
              "relaxation_metadata": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "decision_ref": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "reason",
                      "decision_ref"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "threshold",
              "top_percent",
              "min_peak_length",
              "gap_tolerance",
              "relaxation_metadata"
            ],
            "additionalProperties": false
          },
          "node_id": {
            "enum": [
              "N04"
            ]
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:t01:real:tool-interface:0.1.0:request"
}
