{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "tool_id": {
      "enum": [
        "t01.real.freesasa",
        "t01.real.bepipred"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_mode": {
      "enum": [
        "engineering_example",
        "g0_probe",
        "pipeline"
      ]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "execution_status": {
      "enum": [
        "succeeded",
        "failed",
        "skipped"
      ]
    },
    "usable_for_pipeline": {
      "type": "boolean"
    },
    "review_required": {
      "type": "boolean"
    },
    "result": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "INVALID_INPUT",
              "ASSET_MISSING",
              "HASH_MISMATCH",
              "TOOL_FAILED",
              "OUTPUT_INVALID",
              "TIMEOUT",
              "CANCELLED",
              "RULES_PENDING",
              "MAPPING_UNVERIFIED",
              "MAPPING_UNRELIABLE",
              "QUALITY_LOW",
              "MISSING_RESIDUE",
              "UNSUPPORTED_RESIDUE",
              "VALUE_OUT_OF_RANGE",
              "REVIEW_REQUIRED"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "role": {
            "enum": [
              "raw",
              "diagnostic",
              "log",
              "environment"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\])[A-Za-z0-9_\\u0080-\\uffff][^\\x00-\\x1f]*$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "artifact_id",
          "role",
          "path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parameters_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rule_profile": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tool_exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_artifact_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "adapter_version",
        "tool_version",
        "request_sha256",
        "parameters_sha256",
        "rule_profile",
        "started_at",
        "finished_at",
        "command",
        "tool_exit_code",
        "environment_artifact_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "tool_id",
    "request_id",
    "run_mode",
    "attempt_id",
    "execution_status",
    "usable_for_pipeline",
    "review_required",
    "result",
    "issues",
    "artifacts",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tool_id": {
            "const": "t01.real.freesasa"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "per_residue": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "minItems": 1
                  },
                  "buried_fraction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "per_residue",
                  "buried_fraction"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool_id": {
            "const": "t01.real.bepipred"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "linear_scores": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 1
                  },
                  "linear_peaks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "mean_score": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "start",
                        "end",
                        "mean_score"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "linear_scores",
                  "linear_peaks"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "execution_status": {
            "enum": [
              "succeeded",
              "failed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "failed",
              "skipped"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "null"
          },
          "usable_for_pipeline": {
            "const": false
          }
        },
        "minProperties": 1
      }
    },
    {
      "if": {
        "properties": {
          "review_required": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "usable_for_pipeline": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usable_for_pipeline": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "succeeded"
          },
          "run_mode": {
            "const": "pipeline"
          },
          "review_required": {
            "const": false
          },
          "result": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:t01:real:tool-interface:0.1.0:result"
}
