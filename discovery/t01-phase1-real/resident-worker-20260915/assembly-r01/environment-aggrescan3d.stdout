{"status": "PASS", "boundary": "ENVIRONMENT_ASSEMBLY_NOT_FULL_SCIENTIFIC_WORKFLOW", "group": "aggrescan3d", "supervisor_pid": 1, "results": [{"receipt": {"version": "0.1.0", "backend": "resident-process", "binding": {"attempt_id": "00000000000000000000000000000001", "execution_identity": "00000000000000000000000000000001", "job_id": "environment-aggrescan3d"}, "execution_id": "00000000000000000000000000000001", "request_sha256": "07987e3a41a8604ab3aafdd925fdfcd09b6b48609695d5bd31bac23f8ddf3b0b", "process_name": "resident:89ce0aa881e270bed62146a59c2c54be66ae05ffc75609952f2f95e73e51943f:00000000000000000000000000000001", "state": "succeeded", "stopped_confirmed": true, "exit_code": 0, "outputs": {"output/executor-observation.json": {"size_bytes": 301, "sha256": "7e1c5ce1594f8efcd9f5b3a17432d12615f12727c386023b5bfc0f50e9bd245d"}, "output/native/environment.json": {"size_bytes": 9788, "sha256": "fd5465665d11892824812214f326ea02e41f7d766f94b79fb528d4c18577fe81"}, "output/stderr.txt": {"size_bytes": 0, "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}, "output/stdout.txt": {"size_bytes": 0, "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}, "scientific_signoff": null, "usable_for_pipeline": false, "process_identity": {"pid": 8, "birth": "385136", "platform": "linux"}}, "environment": {"commands": [{"argv": ["/opt/conda/bin/aggrescan", "--help"], "exit_code": 0, "stderr": "", "stdout": "usage: aggrescan [-h] [-c] [-i] [-d] [-m  [...]] [-D] [-w] [--cabs_dir]\n                 [--cabs_config] [--n_models] [-r] [-O] [-f] [-v] [-C] [-M]\n                 [-n]\n\nAggrescan 3D standalone application. Please read and run configReadme.ini to\ntest if the program works.\n\noptional arguments:\n  -h, --help            show this help message and exit\n  -c , --config_file    Input file with specified config options. One can\n                        specify a config file and some additional flags\n                        Command line options have priority over config file.\n                        For further help on creating config files please refer\n                        to configReadme.ini\n  -i , --protein        Input pdb code or a path to file on which the\n                        simulation is performed\n  -d, --dynamic         Use the dynamic module for the simulation. CABS flex\n                        will be used to perform a protein dynamics simulation\n                        If CABS is not installed but present in the filesystem\n                        use --cabs_dir to provide a path to its location\n                        --cabs_config can be used to provide a CABS config\n                        file --n_models can be used to decide how many models\n                        will be taken into further calculations\n  -m  [ ...], --mutate  [ ...]\n                        Provide a residue mutation. This option can be used\n                        multiple times to provide multiple mutations. The\n                        format is: <Old residue><New residue><Residue\n                        number><Chain ID> For example: MW1A to change the\n                        first residue of chain A from methionine to tyrosine.\n                        Please note that this option requires FoldX usage.\n  -D , --distance       Distance cutoff for naccess calculations. Default: 10\n  -w , --work_dir       Sets the directory in which the simulation is\n                        performed\n  --cabs_dir            If used CABS will be run from the provided directory.\n                        Should be used when CABS is not installedor one wants\n                        to use a specific CABS version for the dynamic\n                        simulations\n  --cabs_config         If used CABS will be run with selected config file.\n                        Aggrescan will not parse the config in any way so its\n                        up to the user to supply a working config file.For\n                        debugging purposes use verboisty 3 or higher, CABS\n                        simulation log will be then kept, see the CABSlog file\n                        for details on what went wrong with the CABS run.Few\n                        caveats include:CABS work-dir should not be usedif\n                        --n_models is used it will overwrite --clustering-\n                        medoids in the config file specified by this\n                        optionCABS input option will be overwritten--aa-\n                        rebuild and --remote will be specified by default\n  --n_models            Sets the number of models CABS will generate in the\n                        dynamic analysis.This option will overwrite cabs\n                        config file if you chose both options\n  -r, --remote          Automatically redirects output to a Aggrescan.log file\n                        created in the working directory,turns off log\n                        coloring. Piping standard error will not work with\n                        this option.If a log file already exists it will be\n                        appended to.\n  -O, --overwrite       If the working directory already exists and contains\n                        an output.pdb file this will stop the program to\n                        prevent overwriting possible results that might be\n                        there\n  -f , --foldx          The program will attempt to run foldX on the provided\n                        pdb file or code using the path provided in this\n                        option.\n  -v , --verbose        Sets the verbosity of the program 0 for silent mode\n                        (only critical messages) and 4 for maximum verbosity.\n                        Verbosity level 3 might raise some Exceptions that\n                        would otherwise only be logged as critical messages\n  -C , --chain          Only consider a specific chain while performing\n                        calculations\n  -M , --movie          Create a short movie of the result protein. Available\n                        formats: mp4, webm Usage: -m mp4 Please note pymol and\n                        avconv are used and need to be installed for this\n                        option to work\n  -n , --naccess        Run the simulation with naccess instead of freeSasa.\n                        Run this argument with a path to the naccess program\n                        exectuable.\n"}], "cwd": "/var/lib/t01/resident/aggrescan3d/00000000000000000000000000000001/output", "executable": "/opt/conda/bin/python", "interfaces": null, "internet_socket_denied": true, "native_entry_exists": true, "packages": {"aggrescan3d": "0.9.11", "alabaster": "0.7.10", "anaconda-client": "1.6.14", "anaconda-navigator": "1.8.7", "anaconda-project": "0.8.2", "asn1crypto": "0.24.0", "astroid": "1.6.3", "astropy": "2.0.6", "attrs": "18.1.0", "babel": "2.5.3", "backports-abc": "0.5", "backports.functools-lru-cache": "1.5", "backports.shutil-get-terminal-size": "1.0.0", "backports.ssl-match-hostname": "3.5.0.1", "beautifulsoup4": "4.6.0", "bitarray": "0.8.1", "bkcharts": "0.2", "blaze": "0.11.3", "bleach": "2.1.3", "bokeh": "0.12.16", "boto": "2.48.0", "bottleneck": "1.2.1", "cdecimal": "2.3", "certifi": "2018.4.16", "cffi": "1.11.5", "chardet": "3.0.4", "click": "6.7", "cloudpickle": "0.5.3", "clyent": "1.2.2", "colorama": "0.3.9", "conda": "4.5.10", "conda-build": "3.10.5", "conda-verify": "2.0.0", "configparser": "3.5.0", "contextlib2": "0.5.5", "cryptography": "2.2.2", "cycler": "0.10.0", "cython": "0.28.2", "cytoolz": "0.9.0.1", "dask": "0.17.5", "datashape": "0.5.4", "decorator": "4.3.0", "distributed": "1.21.8", "docutils": "0.14", "entrypoints": "0.2.3", "enum34": "1.1.6", "et-xmlfile": "1.0.1", "fastcache": "1.0.2", "filelock": "3.0.4", "flask": "1.0.2", "flask-cors": "3.0.4", "flask-wtf": "0.14.2", "funcsigs": "1.0.2", "functools32": "3.2.3.post2", "futures": "3.2.0", "gevent": "1.3.0"