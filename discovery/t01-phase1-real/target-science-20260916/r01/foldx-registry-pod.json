{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "labels": {
      "app": "antigen-foldx-registry-r01"
    },
    "name": "antigen-foldx-registry-r01",
    "namespace": "him-ws"
  },
  "spec": {
    "activeDeadlineSeconds": 180,
    "automountServiceAccountToken": false,
    "containers": [
      {
        "command": [
          "python",
          "-B",
          "-c",
          "\nimport base64,json,hashlib,sys\nfrom pathlib import Path\nraw=base64.b64decode(sys.argv[1]);m=json.loads(raw);root=Path('/assets')\nfor r in m['files']:\n    rel=Path(r['path']).relative_to('var/t01-phase1-real/tool-assets')\n    p=root/rel;assert not p.is_symlink() and p.resolve().is_relative_to(root)\n    b=p.read_bytes();assert len(b)==r['bytes'] and hashlib.sha256(b).hexdigest()==r['sha256']\np=root/'foldx-20270131/assets.json'\nassert not p.exists(),'Do not overwrite existing registry'\nwith p.open('xb') as f:f.write(raw)\nassert p.read_bytes()==raw\nprint(json.dumps(dict(status='PASS',created=str(p),sha256=hashlib.sha256(raw).hexdigest(),bytes=len(raw),verified_assets=len(m['files']))))\n",
          ""
        ],
        "image": "harbor-core.base.svc.cluster.local/qcyz/antigen-design@sha256:78b5875032698cafe2ef82057622dd40949e3afbae5eaf69d701effe600b7dc1",
        "imagePullPolicy": "IfNotPresent",
        "name": "registry",
        "resources": {
          "limits": {
            "cpu": "500m",
            "memory": "128Mi"
          },
          "requests": {
            "cpu": "50m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true
        },
        "volumeMounts": [
          {
            "mountPath": "/assets",
            "name": "assets"
          }
        ]
      }
    ],
    "imagePullSecrets": [
      {
        "name": "harbor"
      }
    ],
    "nodeName": "k8s-a100-02",
    "restartPolicy": "Never",
    "securityContext": {
      "fsGroup": 10001,
      "runAsGroup": 10001,
      "runAsNonRoot": true,
      "runAsUser": 10001
    },
    "volumes": [
      {
        "name": "assets",
        "persistentVolumeClaim": {
          "claimName": "antigen-design-assets"
        }
      }
    ]
  }
}
