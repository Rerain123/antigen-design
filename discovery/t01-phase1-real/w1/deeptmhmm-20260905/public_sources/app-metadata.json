        "account_profile_picture_200x200": "https://biolib.com/api/proxy/img/oaAnl6IdrMdbFkO72pZ9wt4LW2sckn8iSSs0NiLlpGA/resize:fill:200:200/czM6Ly9wcm9kdWN0/aW9uLWJpb2xpYi00/YjM4ZTMtZ2VuZXJh/bC1zdG9yYWdlL3By/b2ZpbGUtcGljdHVy/ZXMvY2RqbWlyeWRz/amhqZml2LnBuZw",
        "active_version": {
