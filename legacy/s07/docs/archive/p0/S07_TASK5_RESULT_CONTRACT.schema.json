            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Coverage"
        },
        "query_length": {
          "exclusiveMinimum": 0,
          "title": "Query Length",
          "type": "integer"
        },
        "query_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "reference_length": {
          "exclusiveMinimum": 0,
          "title": "Reference Length",
          "type": "integer"
        },
        "reference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Sha256",
          "type": "string"
        },
        "target_coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Coverage"
        }
